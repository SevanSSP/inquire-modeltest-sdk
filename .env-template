# The model test API
INQUIRE_MODELTEST_API_HOST=https://inquire-modeltest.azurewebsites.net
# Microsoft sign-in: the tenant, the API's app registration, and the client you sign in with
INQUIRE_MODELTEST_TENANT_ID=
INQUIRE_MODELTEST_API_CLIENT_ID=
INQUIRE_MODELTEST_CLIENT_ID=
# Only for a service principal (e.g. the import pipeline); without it you sign in in the browser
INQUIRE_MODELTEST_CLIENT_SECRET=
